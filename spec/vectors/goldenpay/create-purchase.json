{
  "provider": "goldenpay",
  "config": {
    "authKey": "test-auth-key",
    "merchantName": "manat_test",
    "environment": "test"
  },
  "description": "Payment key request: amount in qəpik, hashCode = md5(authKey + merchantName + amount + description); the customer pays on /pay/{paymentKey}",
  "operation": "createPayment",
  "input": {
    "orderId": "A-1001",
    "amount": {
      "amount": 2550,
      "currency": "AZN"
    },
    "description": "Order A-1001",
    "returnUrl": "https://shop.example.az/payment/return",
    "language": "en"
  },
  "http": [
    {
      "expect": {
        "method": "POST",
        "url": "https://rest-newpgtest.goldenpay.az/getPaymentKey",
        "json": {
          "merchantName": "manat_test",
          "amount": 2550,
          "lang": "en",
          "description": "Order A-1001",
          "redirectUrl": "https://shop.example.az/payment/return",
          "hashCode": "69cfeb41b1efd2080bab6d3867dd4c78"
        }
      },
      "respond": {
        "status": 200,
        "json": {
          "status": {
            "code": 1,
            "message": "success"
          },
          "paymentKey": "e93585e2-426d-440a-ae54-67bd20d362be"
        }
      }
    }
  ],
  "expected": {
    "paymentId": "e93585e2-426d-440a-ae54-67bd20d362be",
    "status": "pending",
    "next": {
      "type": "redirect",
      "url": "https://rest-newpgtest.goldenpay.az/pay/e93585e2-426d-440a-ae54-67bd20d362be"
    }
  }
}
