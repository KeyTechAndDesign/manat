{
  "provider": "goldenpay",
  "config": {
    "authKey": "test-auth-key",
    "merchantName": "manat_test",
    "environment": "test"
  },
  "description": "A refund smaller than the payment is reported as partially_refunded (GoldenPay has no partial status)",
  "operation": "refund",
  "input": {
    "paymentId": "e93585e2-426d-440a-ae54-67bd20d362be",
    "amount": {
      "amount": 1000,
      "currency": "AZN"
    }
  },
  "http": [
    {
      "expect": {
        "method": "GET",
        "url": "https://rest-newpgtest.goldenpay.az/getPaymentResult?payment_key=e93585e2-426d-440a-ae54-67bd20d362be&hash_code=a8054ab613e7cbd170ec3979e00ee5c2"
      },
      "respond": {
        "status": 200,
        "json": {
          "status": {
            "code": 1,
            "message": "success"
          },
          "paymentKey": "e93585e2-426d-440a-ae54-67bd20d362be",
          "merchantName": "manat_test",
          "amount": 2550,
          "checkCount": 1,
          "paymentDate": "2026-10-27 10:15:42",
          "cardNumber": "422865******8101",
          "language": "en",
          "description": "Order A-1001",
          "rrn": "630012345678"
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "url": "https://rest-newpgtest.goldenpay.az/reversePaymentKey",
        "json": {
          "paymentKey": "e93585e2-426d-440a-ae54-67bd20d362be",
          "hashCode": "a8054ab613e7cbd170ec3979e00ee5c2",
          "amount": 1000,
          "secretKey": "5d6596ef002702507aca925535df7ff7"
        }
      },
      "respond": {
        "status": 200,
        "json": {
          "status": {
            "code": 817,
            "message": "Payment reversed"
          },
          "paymentKey": "e93585e2-426d-440a-ae54-67bd20d362be",
          "merchantName": "manat_test",
          "amount": 1000,
          "cardNumber": "422865******8101",
          "rrn": "630012345678",
          "paymentDate": "2026-10-27 10:15:42",
          "description": "Order A-1001"
        }
      }
    }
  ],
  "expected": {
    "paymentId": "e93585e2-426d-440a-ae54-67bd20d362be",
    "status": "partially_refunded"
  }
}
