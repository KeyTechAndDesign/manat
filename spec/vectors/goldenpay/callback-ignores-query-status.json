{
  "provider": "goldenpay",
  "config": {
    "authKey": "test-auth-key",
    "merchantName": "manat_test",
    "environment": "test"
  },
  "description": "A status in the query string is ignored; the API says the payment failed",
  "operation": "verifyCallback",
  "input": {
    "method": "GET",
    "query": {
      "payment_key": "e93585e2-426d-440a-ae54-67bd20d362be",
      "status": "success"
    }
  },
  "http": [
    {
      "expect": {
        "method": "GET",
        "url": "https://rest-newpgtest.goldenpay.az/getPaymentResult?payment_key=e93585e2-426d-440a-ae54-67bd20d362be&hash_code=a8054ab613e7cbd170ec3979e00ee5c2"
      },
      "respond": {
        "status": 200,
        "json": {
          "status": {
            "code": 816,
            "message": "Payment failed"
          },
          "paymentKey": "e93585e2-426d-440a-ae54-67bd20d362be",
          "merchantName": "manat_test",
          "amount": 2550,
          "checkCount": 1,
          "paymentDate": "2026-10-27 10:15:42",
          "cardNumber": null,
          "language": "en",
          "description": "Order A-1001",
          "rrn": null
        }
      }
    }
  ],
  "expected": {
    "paymentId": "e93585e2-426d-440a-ae54-67bd20d362be",
    "status": "failed"
  }
}
