{
  "provider": "payriff",
  "config": {
    "secretKey": "test-secret-key"
  },
  "description": "Capture of a pre-auth that was never paid: Payriff test mode answers HTTP 400 with code 01000",
  "operation": "capture",
  "input": {
    "paymentId": "8af6c15e-6c47-49a2-9350-b1dba11be0d8"
  },
  "http": [
    {
      "expect": {
        "method": "POST",
        "url": "https://api.payriff.com/api/v3/complete",
        "headers": {
          "authorization": "test-secret-key"
        },
        "json": {
          "orderId": "8af6c15e-6c47-49a2-9350-b1dba11be0d8"
        }
      },
      "respond": {
        "status": 400,
        "json": {
          "code": "01000",
          "message": "Transaction status is not preauth-approved!.\n Support ticket: 472629",
          "route": "dashboard/main",
          "responseId": "c90bc94d6c65472a92f37749328c3eea",
          "responseDetails": null
        }
      }
    }
  ],
  "expected": {
    "error": "provider_error",
    "providerCode": "01000"
  }
}
