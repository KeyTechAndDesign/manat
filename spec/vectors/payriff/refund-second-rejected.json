{
  "provider": "payriff",
  "config": {
    "secretKey": "test-secret-key"
  },
  "description": "A second refund after a partial one: Payriff test mode accepts one refund per order and answers HTTP 400, code 01000",
  "operation": "refund",
  "input": {
    "paymentId": "ff19f372-f7d2-469b-816d-12721b68b81d",
    "amount": {
      "amount": 30,
      "currency": "AZN"
    }
  },
  "http": [
    {
      "expect": {
        "method": "POST",
        "url": "https://api.payriff.com/api/v3/refund",
        "headers": {
          "authorization": "test-secret-key"
        },
        "json": {
          "orderId": "ff19f372-f7d2-469b-816d-12721b68b81d",
          "refundReason": "Refund",
          "amount": 0.3
        }
      },
      "respond": {
        "status": 400,
        "json": {
          "code": "01000",
          "message": "Transaction status is not approved!.\n Support ticket: 527450",
          "route": "dashboard/main",
          "responseId": "b66a92af50624798998f9684bfac8215",
          "responseDetails": null
        }
      }
    }
  ],
  "expected": {
    "error": "provider_error",
    "providerCode": "01000"
  }
}
