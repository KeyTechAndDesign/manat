{
  "provider": "yigim",
  "config": {
    "merchant": "manat_test",
    "apiKey": "test-api-key",
    "biller": "BLR0001",
    "environment": "test"
  },
  "description": "verifyCallback: the webhook carries only reference and is unsigned; a status in its query is ignored and payment/status decides",
  "operation": "verifyCallback",
  "input": {
    "method": "GET",
    "query": {
      "reference": "A-1001",
      "status": "00"
    }
  },
  "http": [
    {
      "expect": {
        "method": "GET",
        "url": "https://sandbox.api.pay.yigim.az/payment/status?reference=A-1001",
        "headers": {
          "X-Merchant": "manat_test",
          "X-API-Key": "test-api-key",
          "X-Type": "JSON"
        }
      },
      "respond": {
        "status": 200,
        "json": {
          "reference": "A-1001",
          "datetime": "2026-10-27T14:30:00.100",
          "method": "Card",
          "type": "SMS",
          "pan": "510068******0966",
          "expiry": "0928",
          "amount": "1",
          "fee": "0",
          "currency": "944",
          "biller": "BLR0001",
          "system": "MasterCard",
          "issuer": "Test Bank",
          "rrn": "630012345678",
          "approval": "016355",
          "3ds": "00",
          "extra": [],
          "refund": [],
          "transactionList": [],
          "status": "S2",
          "code": 0,
          "message": "OK"
        }
      }
    }
  ],
  "expected": {
    "paymentId": "A-1001",
    "orderId": "A-1001",
    "status": "pending"
  }
}
