{
  "provider": "yigim",
  "config": {
    "merchant": "manat_test",
    "apiKey": "test-api-key",
    "biller": "BLR0001",
    "environment": "test"
  },
  "description": "createPayment: the sandbox answers HTTP 200 with code 1 for an unknown merchant; reported as provider_error",
  "operation": "createPayment",
  "input": {
    "orderId": "A-1005",
    "amount": {
      "amount": 100,
      "currency": "AZN"
    },
    "returnUrl": "https://shop.example.az/payment/return"
  },
  "http": [
    {
      "expect": {
        "method": "GET",
        "url": "https://sandbox.api.pay.yigim.az/payment/create?reference=A-1005&type=SMS&amount=100&currency=944&biller=BLR0001&template=TPL0001&language=az&extra=back-url%3Dhttps%3A%2F%2Fshop.example.az%2Fpayment%2Freturn%3Bfail-url%3Dhttps%3A%2F%2Fshop.example.az%2Fpayment%2Freturn",
        "headers": {
          "X-Merchant": "manat_test",
          "X-API-Key": "test-api-key",
          "X-Type": "JSON"
        }
      },
      "respond": {
        "status": 200,
        "json": {
          "extra": [],
          "refund": [],
          "transactionList": [],
          "code": 1,
          "message": "Invalid merchant name specified (HTTP Header 'X-Merchant' value)"
        }
      }
    }
  ],
  "expected": {
    "error": "provider_error",
    "providerCode": "1"
  }
}
