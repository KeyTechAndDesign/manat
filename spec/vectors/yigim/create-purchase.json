{
  "provider": "yigim",
  "config": {
    "merchant": "manat_test",
    "apiKey": "test-api-key",
    "biller": "BLR0001",
    "environment": "test"
  },
  "description": "createPayment: SMS payment in qəpik with a numeric currency, description, language and webhook; returnUrl is not sent",
  "operation": "createPayment",
  "input": {
    "orderId": "A-1001",
    "amount": {
      "amount": 2550,
      "currency": "AZN"
    },
    "returnUrl": "https://shop.example.az/payment/return",
    "callbackUrl": "https://shop.example.az/yigim/webhook",
    "description": "Sifariş A-1001",
    "language": "en"
  },
  "http": [
    {
      "expect": {
        "method": "GET",
        "url": "https://sandbox.api.pay.yigim.az/payment/create?reference=A-1001&type=SMS&amount=2550&currency=944&biller=BLR0001&description=Sifari%C5%9F+A-1001&template=TPL0001&language=en&callback=https%3A%2F%2Fshop.example.az%2Fyigim%2Fwebhook",
        "headers": {
          "X-Merchant": "manat_test",
          "X-API-Key": "test-api-key",
          "X-Type": "JSON"
        }
      },
      "respond": {
        "status": 200,
        "json": {
          "extra": [],
          "refund": [],
          "transactionList": [],
          "code": 0,
          "message": "OK",
          "url": "https://sandbox.api.pay.yigim.az/payment/45617812104414"
        }
      }
    }
  ],
  "expected": {
    "paymentId": "A-1001",
    "status": "pending",
    "next": {
      "type": "redirect",
      "url": "https://sandbox.api.pay.yigim.az/payment/45617812104414"
    }
  }
}
