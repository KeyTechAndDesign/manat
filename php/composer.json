{
    "name": "keytd/manat",
    "description": "One API for Azerbaijani online payment providers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["azerbaijan", "payments", "azn", "manat", "payment-gateway", "kapital-bank", "azericard", "payriff", "epoint", "goldenpay"],
    "authors": [
        {"name": "KeyTD", "email": "info@keytd.com", "homepage": "https://keytd.com"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {"Manat\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Manat\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
