{
    "name": "keytd/manat",
    "description": "One API for Azerbaijani online payment providers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "azerbaijan",
        "payments",
        "azn",
        "manat",
        "payment-gateway",
        "kapital-bank",
        "azericard",
        "payriff",
        "epoint",
        "goldenpay"
    ],
    "homepage": "https://github.com/KeyTechAndDesign/manat",
    "support": {
        "issues": "https://github.com/KeyTechAndDesign/manat/issues",
        "source": "https://github.com/KeyTechAndDesign/manat"
    },
    "authors": [
        {
            "name": "KeyTD",
            "email": "info@keytd.com",
            "homepage": "https://keytd.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Manat\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manat\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c php/phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
