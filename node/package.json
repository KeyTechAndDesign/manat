{
  "name": "@keytd/manat",
  "version": "0.2.0",
  "description": "One API for Azerbaijani online payment providers.",
  "license": "MIT",
  "author": "KeyTD <info@keytd.com>",
  "homepage": "https://github.com/KeyTechAndDesign/manat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeyTechAndDesign/manat.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/KeyTechAndDesign/manat/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "cp ../LICENSE LICENSE && npm run build",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "azerbaijan",
    "payments",
    "azn",
    "manat",
    "payment-gateway",
    "kapital-bank",
    "azericard",
    "payriff",
    "epoint",
    "goldenpay",
    "yigim"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
